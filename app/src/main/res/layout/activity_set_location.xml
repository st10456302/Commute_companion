<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_lighter">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@null"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/set_location"
                    style="@style/Text.Title"
                    android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card_white"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md">

                <ImageView
                    android:layout_width="@dimen/icon_size_sm"
                    android:layout_height="@dimen/icon_size_sm"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_secondary" />

                <EditText
                    android:id="@+id/etSearchLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:background="@null"
                    android:hint="@string/search_address_hint"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_body"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/suggested"
                android:textSize="@dimen/text_tiny"
                android:letterSpacing="0.05"
                android:textColor="@color/text_secondary" />



            <!-- Live OpenStreetMap preview -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card_white"
                android:clipChildren="true"
                android:clipToOutline="true">

                <com.mapbox.maps.MapView
                    android:id="@+id/locationMap"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp" />

                <TextView
                    android:id="@+id/tvMapStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/spacing_sm"
                    android:background="#CCFFFFFF"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Enter an address to locate it"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_tiny" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="4dp"
                    android:background="#CCFFFFFF"
                    android:padding="3dp"
                    android:text="© OpenStreetMap contributors"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/save_as"
                android:textSize="@dimen/text_tiny"
                android:letterSpacing="0.05"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipHome"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_button_outline_light"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:text="🏠  Home"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/chipWork"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="@drawable/bg_card_selected"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:text="💼  Work"
                    android:textColor="@color/teal_dark"
                    android:textSize="@dimen/text_small" />

                <TextView
                    android:id="@+id/chipCampus"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_button_outline_light"
                    android:gravity="center"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:text="🎓  Campus"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_small" />
            </LinearLayout>

            <TextView
                android:id="@+id/chipCustom"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_button_outline_light"
                android:gravity="center"
                android:paddingStart="@dimen/spacing_md"
                android:paddingEnd="@dimen/spacing_md"
                android:text="✏️  Custom"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_small" />

            <Button
                android:id="@+id/btnSaveLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/save_location"
                style="@style/Button.Primary" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNavBar"
        layout="@layout/bottom_nav_bar" />

</LinearLayout>